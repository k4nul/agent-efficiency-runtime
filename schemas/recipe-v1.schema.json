{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/k4nul/agent-efficiency-runtime/schemas/recipe-v1.schema.json",
  "title": "AER recipe v1",
  "type": "object",
  "required": ["version", "name", "inputs", "steps"],
  "properties": {
    "version": {"const": 1},
    "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "description": {"type": "string"},
    "inputs": {"type": "object"},
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": ["id", "uses"],
        "properties": {
          "id": {"type": "string"},
          "uses": {"type": "string"},
          "with": {"type": "object"}
        }
      }
    }
  }
}

