{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/k4nul/agent-efficiency-runtime/schemas/patch-v1.schema.json",
  "title": "AER patch specification v1",
  "type": "object",
  "required": ["version", "operations"],
  "properties": {
    "version": {"const": 1},
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "required": ["op"],
        "properties": {"op": {"type": "string"}, "target": {"type": "string"}},
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}

